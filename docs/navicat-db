-- ----------------------------
-- Table structure for aito_car_sku
-- ----------------------------
DROP TABLE IF EXISTS `aito_car_sku`;
CREATE TABLE `aito_car_sku` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '车源id',
  `owner_id` bigint NOT NULL DEFAULT '-1' COMMENT '车商id',
  `owner_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL DEFAULT '' COMMENT '车商名称',
  `spec_id` int NOT NULL DEFAULT '-1' COMMENT '车规id',
  `spec_name` varchar(20) NOT NULL DEFAULT '' COMMENT '车规名称',
  `brand_id` bigint NOT NULL DEFAULT '-1' COMMENT '品牌id',
  `brand_name` varchar(50) NOT NULL DEFAULT '' COMMENT '品牌名称',
  `series_id` bigint NOT NULL DEFAULT '-1' COMMENT '车系id',
  `series_name` varchar(50) NOT NULL DEFAULT '' COMMENT '车系名称',
  `model_id` bigint NOT NULL DEFAULT '-1' COMMENT '车型id',
  `model_name` varchar(200) NOT NULL DEFAULT '' COMMENT '车型名称',
  `outer_color_id` bigint NOT NULL DEFAULT '-1' COMMENT '外饰颜色id',
  `outer_color_name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL DEFAULT '' COMMENT '外饰颜色名称',
  `guide_price` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL DEFAULT '' COMMENT '指导价',
  `bare_car_price` bigint DEFAULT NULL COMMENT '裸车价，单位分',
  `logistics_cost` bigint DEFAULT NULL COMMENT '物流成本，单位分',
  `interest_cost` bigint DEFAULT NULL COMMENT '利息成本，单位分',
  `other_cost` bigint DEFAULT NULL COMMENT '其他成本，单位分',
  `sku_tag` json DEFAULT NULL COMMENT '标签信息，包含最新上架/价格最低/本月主推',
  `settlement_price` bigint DEFAULT NULL COMMENT '综合采购成本，单位分',
  `sale_price` bigint DEFAULT NULL COMMENT '对客销售价-全款',
  `sale_price_finance` bigint DEFAULT NULL COMMENT '对客销售价-金融',
  `intended_landing_price` bigint DEFAULT NULL COMMENT '意向落地价，单位分，用于线索跟进预算匹配',
  `sale_price_expire_date` date DEFAULT NULL COMMENT '销售价到期日',
  `is_virtual_source` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否虚拟仓车源',
  `in_store_insurance` tinyint(1) NOT NULL DEFAULT '1' COMMENT '是否店内保险',
  `can_issue_vat_invoice` tinyint(1) NOT NULL DEFAULT '1' COMMENT '是否能开增票',
  `energy_type` int NOT NULL DEFAULT '1' COMMENT '类型：1-燃油车，2-新能源车',
  `finance_manager_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL DEFAULT '' COMMENT '金融车业务经理',
  `sale_status` tinyint NOT NULL DEFAULT '1' COMMENT '上下架状态，0未完善，1上架，2下架',
  `memo` varchar(500) NOT NULL DEFAULT '' COMMENT '备注',
  `creator_id` bigint NOT NULL DEFAULT '-1' COMMENT '创建人id',
  `creator_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL DEFAULT '' COMMENT '创建人名称',
  `sku_picture` varchar(512) DEFAULT NULL COMMENT 'sku展示图片url',
  `is_deleted` tinyint NOT NULL DEFAULT '0' COMMENT '逻辑删除字段',
  `gmt_create` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `gmt_modified` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '最近修改时间',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=66 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC COMMENT='卖好车车源sku表';

