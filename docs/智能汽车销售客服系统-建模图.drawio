    <!-- ====== SECTION 2: Change Detection ====== -->
    <mxCell id="sec2-bg" value="" style="rounded=1;fillColor=#FFF8E1;strokeColor=#FF8F00;strokeWidth=1.5;dashed=1;opacity=50;" vertex="1" parent="1">
      <mxGeometry x="30" y="145" width="740" height="55" as="geometry" />
    </mxCell>
    <mxCell id="sec2-label" value="变更检测层" style="text;fontSize=13;fontStyle=1;fillColor=#FF8F00;fontColor=#fff;align=center;" vertex="1" parent="1">
      <mxGeometry x="30" y="145" width="90" height="22" as="geometry" />
    </mxCell>
    <mxCell id="cd-box" value="变更检测：哈希对比 + 时间戳对比 + DB事件监听 + MQ消息消费" style="shape=hexagon;perimeter=hexagonPerimeter2;fillColor=#FFCA28;fontColor=#333;strokeColor=#FFA000;fontStyle=1;size=8;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="260" y="155" width="280" height="40" as="geometry" />
    </mxCell>

    <!-- Arrow: change detection to ETL -->
    <mxCell id="arr-cd-etl" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="cd-box" target="etl-header">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ====== SECTION 3: ETL Pipeline (Core) ====== -->
    <mxCell id="sec3-bg" value="" style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;dashed=1;opacity=40;" vertex="1" parent="1">
      <mxGeometry x="30" y="210" width="740" height="340" as="geometry" />
    </mxCell>
    <mxCell id="sec3-label" value="ETL Pipeline 核心处理" style="text;fontSize=13;fontStyle=1;fillColor=#C62828;fontColor=#fff;align=center;" vertex="1" parent="1">
      <mxGeometry x="30" y="210" width="170" height="22" as="geometry" />
    </mxCell>

    <!-- ETL Step 1: Format Parse -->
    <mxCell id="etl-header" value="" style="rounded=1;fillColor=#EF5350;fontColor=#fff;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="50" y="245" width="40" height="290" as="geometry" />
    </mxCell>
    <mxCell id="etl1" value="[1] 格式解析
.md→MarkdownReader
.txt→TextReader
.pdf→PagePdfReader
图片→VLM描述
表格→LaTeX/Markdown" style="rounded=1;fillColor=#EF9A9A;fontColor=#333;strokeColor=#E53935;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="100" y="245" width="130" height="75" as="geometry" />
    </mxCell>

    <!-- ETL Step 2: Proposition Extract -->
    <mxCell id="etl2" value="[2] 命题提取 ⭐核心
结构化数据：
SQL+模板渲染
非结构化：
LLM→原子事实列表
每条：主体+属性+值+时序标记" style="rounded=1;fillColor=#EF5350;fontColor=#fff;strokeColor=#C62828;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="255" y="245" width="145" height="75" as="geometry" />
    </mxCell>

    <!-- ETL Step 3: Entity Resolution -->
    <mxCell id="etl3" value="[3] 实体解析与去重
同义词归一:
比亚迪宋PLUS = BYD宋PLUS
全称/缩写映射:
DM-i超级混动 ↔ DM-i" style="rounded=1;fillColor=#EF9A9A;fontColor=#333;strokeColor=#E53935;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="425" y="245" width="140" height="75" as="geometry" />
    </mxCell>

    <!-- ETL Step 4: Clustering -->
    <mxCell id="etl4" value="[4] 聚类成Chunk
同车型参数归一组
同场景话术归一组
控制 200-500字/Chunk
每Chunk≈3-8条事实" style="rounded=1;fillColor=#EF5350;fontColor=#fff;strokeColor=#C62828;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="590" y="245" width="130" height="75" as="geometry" />
    </mxCell>

    <!-- ETL Step 5: Parent Doc -->
    <mxCell id="etl5" value="[5] 父文档关联
每个Chunk→parent_doc_id
检索时命中Chunk
可展开父文档获取完整上下文" style="rounded=1;fillColor=#EF9A9A;fontColor=#333;strokeColor=#E53935;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="100" y="340" width="155" height="65" as="geometry" />
    </mxCell>

    <!-- ETL Step 6: Embedding -->
    <mxCell id="etl6" value="[6] Embedding生成
BGE-M3 一次调用产出:
• Dense (1024维 语义向量)
• Sparse (词权重 倒排索引)
• Multi-Vector (token级匹配)
批量处理 ≤8192 token/批" style="rounded=1;fillColor=#EF5350;fontColor=#fff;strokeColor=#C62828;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="280" y="340" width="160" height="80" as="geometry" />
    </mxCell>

    <!-- ETL Step 7: Write to Vector DB -->
    <mxCell id="etl7" value="[7] 写入向量库
稠密→Chroma/Milvus(HNSW)
稀疏→Elasticsearch(倒排)
多向量→多向量Collection
元数据随向量存储" style="rounded=1;fillColor=#EF9A9A;fontColor=#333;strokeColor=#E53935;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="465" y="340" width="145" height="80" as="geometry" />
    </mxCell>

    <!-- ETL Step 8: Blue-Green -->
    <mxCell id="etl8" value="[8] 索引切换 (蓝绿部署)
新索构建在备用Collection
→ 质量验证通过
→ 原子切换alias
→ 旧版保留作回滚快照" style="rounded=1;fillColor=#C62828;fontColor=#fff;strokeColor=#8E0000;fontStyle=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="635" y="340" width="125" height="80" as="geometry" />
    </mxCell>

    <!-- ETL flow arrows -->
