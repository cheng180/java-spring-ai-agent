    <!-- Arrow: sources to change detection -->
    <mxCell id="arr-src-cd" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#333;strokeWidth=1.5;" edge="1" parent="1" source="src-db" target="cd-box">
